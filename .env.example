# Copiá este archivo como .env y reemplazá la IP por la de tu computadora.
# El teléfono y la PC deben estar en la misma red Wi-Fi.
# Esta URL no es un secreto: sólo indica dónde está la API.
# No pongas acá JWT_SECRET, contraseñas ni claves privadas; esos datos pertenecen al servidor.
# Si dejás la variable vacía o no creás .env, la app trabaja con su respaldo local.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
